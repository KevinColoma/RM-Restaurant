<%- include('header') -%>

<div class="page-wrapper">
<div class="content">
<div class="page-header">
<div class="page-title">
<h4 data-i18n="list.orders_title">Orders List</h4>
<h6 data-i18n="list.orders_sub">Manage your orders</h6>
</div>
<div class="page-btn">
<a href="/export/orders/pdf" class="btn btn-added me-2"><img src="assets/img/icons/pdf.svg" alt="img" class="me-1">PDF</a>
<a href="/export/orders/csv" class="btn btn-added"><img src="assets/img/icons/excel.svg" alt="img" class="me-1">CSV</a>
</div>
</div>

<div class="card">
<div class="card-body">
<form method="GET" action="/orders-list" class="row mb-3 align-items-end">
<div class="col-lg-3 col-sm-6 col-12">
<div class="form-group">
<label data-i18n="table.order_type">Order Type</label>
<select name="orderType" class="form-control">
<option value="">All</option>
<option value="dine-in"<%= (typeof query !== 'undefined' && query.orderType === 'dine-in') ? ' selected' : '' %>>Dine-in</option>
<option value="takeaway"<%= (typeof query !== 'undefined' && query.orderType === 'takeaway') ? ' selected' : '' %>>Takeaway</option>
<option value="delivery"<%= (typeof query !== 'undefined' && query.orderType === 'delivery') ? ' selected' : '' %>>Delivery</option>
</select>
</div>
</div>
<div class="col-lg-3 col-sm-6 col-12">
<div class="form-group">
<label data-i18n="common.from">From</label>
<input type="date" name="dateFrom" class="form-control" value="<%= (typeof query !== 'undefined' && query.dateFrom) || '' %>">
</div>
</div>
<div class="col-lg-3 col-sm-6 col-12">
<div class="form-group">
<label data-i18n="common.to">To</label>
<input type="date" name="dateTo" class="form-control" value="<%= (typeof query !== 'undefined' && query.dateTo) || '' %>">
</div>
</div>
<div class="col-lg-3 col-sm-6 col-12 d-flex align-items-end">
<div class="form-group mb-0 d-flex">
<button type="submit" class="btn btn-primary"><span data-i18n="common.apply">Apply</span></button>
<a href="/orders-list" class="btn btn-secondary ms-2"><span data-i18n="common.reset">Reset</span></a>
</div>
</div>
</form>
<div class="table-responsive">
<table class="table datanew">
<thead>
<tr>
<th data-i18n="table.order_id">Order ID</th>
<th data-i18n="table.items">Items</th>
<th data-i18n="table.order_type">Order Type</th>
<th data-i18n="table.created_by">Created By</th>
<th data-i18n="table.total">Total Amount</th>
<th data-i18n="table.tax">Tax</th>
<th data-i18n="table.comment">Comment</th>
<th data-i18n="table.date">Date</th>
<th data-i18n="table.action">Action</th>
</tr>
</thead>
<tbody>

<% orders.forEach(order => { %>
    <tr>
        <td><%= order._id %></td>
        <td><%= order.items.map(i => i.menuItem ? i.menuItem.item : 'Unknown').join(', ') %></td>
        <td><%= order.orderType %></td>
        <td><%= order.usuarioName || '-' %></td>
        <td><%= order.totalAmount.toFixed(2) %></td>
        <td><%= order.taxAmount.toFixed(2) %></td>
        <td><%= order.comment || '' %></td>
        <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
        <td>
            <a href="javascript:void(0);" onclick="cancelOrder('<%= order._id %>')" class="btn btn-sm btn-danger">Cancel</a>
        </td>
    </tr>
<% }) %>

</tbody>
</table>
</div>
</div>
</div>

</div>
</div>
</div>

<script src="assets/plugins/sweetalert/sweetalert2.all.min.js"></script>
<script>
    function cancelOrder(id) {
        Swal.fire({
            title: 'Cancel Order?',
            text: "This action cannot be undone!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, cancel it!'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch('/api/orders/' + id, { method: 'DELETE' })
                    .then(res => {
                        if (res.ok) {
                            Swal.fire('Cancelled!', 'Order has been cancelled.', 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Error!', 'Failed to cancel order.', 'error');
                        }
                    })
                    .catch(err => {
                        Swal.fire('Error!', 'Request failed: ' + err.message, 'error');
                    });
            }
        });
    }
</script>
<%- include('footer') -%>